    {
      "name": "Audit - the new employee's trail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit?employeeId={{newId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "audit"
          ],
          "query": [
            {
              "key": "employeeId",
              "value": "{{newId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"joiner, mover, SoD block and leaver are all recorded\", function () {",
              "  const actions = pm.response.json().entries.map(e => e.action);",
              "  [\"JOINER\",\"MOVER\",\"SOD_BLOCKED\",\"LEAVER\"].forEach(a => pm.expect(actions).to.include(a));",
              "});"
            ]
          }
        }
      ]
    },
