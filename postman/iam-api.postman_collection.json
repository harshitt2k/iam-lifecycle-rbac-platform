{
  "info": {
    "name": "IAM Lifecycle & RBAC API",
    "description": "Run the whole collection top to bottom (Runner). Each run hires a fresh employee, moves, grants, blocks a conflicting grant, and terminates. Requests use baseUrl = http://localhost:8081/iam-api/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"status ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List employees",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"at least 20 employees\", function () { pm.expect(pm.response.json().length).to.be.at.least(20); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get S402 (has a DIRECT APPROVE_PAYMENT)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/S402",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "S402"
          ]
        },
        "description": "Seeded problem: SoD violation plus direct access."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"S402 holds APPROVE_PAYMENT directly\", function () {",
              "  const e = pm.response.json().entitlements.find(x => x.name === \"APPROVE_PAYMENT\");",
              "  pm.expect(e.source).to.eql(\"DIRECT\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get unknown employee",
      "request": {
        "method": "GET",
