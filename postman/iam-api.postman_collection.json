          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Joiner - hire a new engineer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"{{newId}}\",\n  \"givenName\": \"Asha\",\n  \"familyName\": \"Rao\",\n  \"email\": \"{{newId}}@lab-corp.test\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Backend Engineer\",\n  \"supervisorId\": \"S101\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// a fresh id every run, so the whole collection can be run again and again",
              "pm.collectionVariables.set(\"newId\", \"T\" + Math.floor(10000 + Math.random() * 90000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"got the rule-based roles\", function () {",
              "  const roles = pm.response.json().roles;",
              "  pm.expect(roles).to.include(\"ENG_BASE\");",
              "  pm.expect(roles).to.include(\"ENG_DEVELOPER\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Joiner - same id again is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"{{newId}}\",\n  \"givenName\": \"Asha\",\n  \"familyName\": \"Rao\",\n  \"email\": \"{{newId}}@lab-corp.test\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Backend Engineer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Joiner - missing fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"T1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Mover - move to Procurement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{newId}}/move",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{newId}}",
            "move"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"department\": \"Operations\",\n  \"jobTitle\": \"Procurement Officer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"old access gone, new access in\", function () {",
              "  const j = pm.response.json();",
              "  pm.expect(j.roles).to.include(\"OPS_PROCUREMENT\");",
              "  pm.expect(j.roles).to.not.include(\"ENG_DEVELOPER\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Grant DIRECT APPROVE_PAYMENT - blocked by SoD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{newId}}/entitlements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{newId}}",
            "entitlements"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"entitlement\": \"APPROVE_PAYMENT\",\n  \"reason\": \"Postman SoD demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Procurement already holds CREATE_VENDOR, so this must be refused."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
              "pm.test(\"reports the violation\", function () {",
              "  pm.expect(pm.response.json().violations.length).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Grant DIRECT JIRA_ACCESS - allowed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{newId}}/entitlements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{newId}}",
            "entitlements"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"entitlement\": \"JIRA_ACCESS\",\n  \"reason\": \"Cross-team project\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Revoke DIRECT JIRA_ACCESS",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{newId}}/entitlements/JIRA_ACCESS?reason=project ended",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{newId}}",
            "entitlements",
            "JIRA_ACCESS"
          ],
          "query": [
            {
              "key": "reason",
              "value": "project ended"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Leaver - terminate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "postman"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{newId}}/leave",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{newId}}",
            "leave"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exitedOn\": \"2026-10-26\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"terminated with no access left\", function () {",
              "  const j = pm.response.json();",
              "  pm.expect(j.employee.status).to.eql(\"TERMINATED\");",
              "  pm.expect(j.roles.length).to.eql(0);",
              "  pm.expect(j.entitlements.length).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
